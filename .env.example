# ============================================================================
# BHUMI National Digital Platform - Environment Configuration Example
# Copy this file to .env and adjust credentials as appropriate
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL + PostGIS)
# When left empty, the server automatically starts in resilient embedded mode
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/bhumi

# Python FastAPI Policy Simulation Service
PYTHON_SIM_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=bhumi_sovereign_dev_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# GeoServer WMS / Satellite Tile Endpoint (Optional)
GEOSERVER_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms
